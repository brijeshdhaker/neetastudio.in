{
    "postman.settings.dotenv-detection-notification-visibility": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    // PHP Debug configuration
    "php.debug.ideKey": "vscode",
    // PHPUnit configuration
    //"phpunit.php": "/usr/bin/php",
    "phpunit.phpunit": "vendor/bin/phpunit",
    "phpunit.clearOutputOnRun": true,
    // "neetastudio.in" is the container name in the docker-compose.yml
    //"phpunit.command": "docker exec -e 'XDEBUG_TRIGGER=vscode' -t neetastudio.in /bin/sh -c \"${php} ${phpargs} ${phpunit} ${phpunitargs}\"",
    //"phpunit.command": "docker run --rm -t -e 'XDEBUG_TRIGGER=vscode' -v ${PWD}:/var/www/html -v ${PWD}/conf/php/php.ini:/usr/local/etc/php/php.ini -w /var/www/html --env-file ${PWD}/envvars --add-host docker.sandbox.net:172.18.0.1 --name phpunit-test brijeshdhaker/php:8.4.13 ${php} ${phpargs} ${phpunit} ${phpunitargs}",
    "phpunit.args": [
        "--colors",
        "--log-junit /tmp/neetastudio-phpunit-log.xml", 
        "--bootstrap ./bootstrap.php", 
        "--configuration ./phpunit.xml"
    ],
    "php.validate.enable": false,
    // This name of the launch configuration for PHP XDEBUG extension
    //"phpunit.debuggerConfig": "Listen for Xdebug",
}

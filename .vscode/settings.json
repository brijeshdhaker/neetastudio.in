{
    "postman.settings.dotenv-detection-notification-visibility": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "phpunit.php": "/usr/bin/php",
    "phpunit.phpunit": "${workspaceFolder}/vendor/bin/phpunit",
    "phpunit.clearOutputOnRun": true,
    "php.debug.ideKey": "vscode",
    "phpunit.xdebugPort": 9003,
    // "app" is the container name in the docker-compose.yml
    // "phpunit.command": "docker compose -f compose.yaml exec -e 'XDEBUG_TRIGGER=vscode' neetastudio.in bash -c",
    "phpunit.args": [
        "--colors",
        "--log-junit", 
        "/tmp/nb-phpunit-log.xml", 
        "--bootstrap ${workspaceFolder}/bootstrap.php", 
        "--configuration ${workspaceFolder}/phpunit.xml",
        "--filte %\btestGetMapping\b%"
    ],
    "phpunit.environment": {
        "XDEBUG_SESSION": "1",
        "XDEBUG_SESSION_START": "vscode",
        "XDEBUG_MODE": "develop,debug,coverage,profile",
        "XDEBUG_CONFIG": "client_port=9003",
        "APP_ENV": "TEST",
        "APP_NAME": "neetastudio.in",
        "APP_DEBUG": "true",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "array",
        "QUEUE_CONNECTION": "sync",
        "DB_HOST": "mysqlserver.sandbox.net",
        "DB_USER": "neetastudio",
        "DB_NAME": "NEETASTUDIO",
        "DB_PASSWORD": "paSSW0rd",
        "DB_PASSWORD_FILE_PATH": "/run/secrets/mysql-root-password"
    },
    "phpunit.paths": {
        "${workspaceFolder}": "/var/www/neetastudio.in",
    },
    // This name of the launch configuration for PHP XDEBUG extension
    //"phpunit.debuggerConfig": "Listen for Xdebug",
}

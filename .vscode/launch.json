{
    "version": "0.2.0",
    "configurations": [
        {
        "name": "Listen for Xdebug",
        "type": "php",
        "request": "launch",
        "port": 9003,
        "pathMappings": {
            "/var/www/html": "${workspaceRoot}"
        },
        "runtimeArgs": [
            "-dxdebug.mode=develop,debug,coverage",
            "-dxdebug.start_with_request=yes",
            "-dxdebug.idekey=netbeans-xdebug"
        ]        
    }]
}
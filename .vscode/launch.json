{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch currently open script",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "port": 9000,
            "runtimeArgs": [
                "-dxdebug.start_with_request=yes"
            ],
            "env": {
                "XDEBUG_MODE": "develop,debug,coverage,profile",
                "XDEBUG_CONFIG": "client_port=${port}"
            },
            "envFile": "${workspaceFolder}/envvars"
        },
        {
            "name": "Launch Built-in web server",
            "type": "php",
            "request": "launch",
            "runtimeArgs": [
                "-dxdebug.mode=develop,debug,coverage,profile",
                "-dxdebug.client_port=9000",
                "-S",
                "localhost:8000",
                "-c ${workspaceFolder}/conf/php/php.ini"
            ],
            "program": "",
            "cwd": "${workspaceRoot}",
            "port": 9000,
            "serverReadyAction": {
                "pattern": "Development Server \\(http://localhost:([0-9]+)\\) started",
                "uriFormat": "http://neetastudio.in:%s",
                "action": "openExternally"
            },
            "env": {
                "XDEBUG_MODE": "develop,debug,coverage,profile",
                "XDEBUG_CLIENT_PORT": "9000",
                "XDEBUG_TRIGGER": "vscode",
                "APP_ENV": "DEV",
                "APP_NAME": "neetastudio.in",
                "DB_HOST": "mysqlserver.sandbox.net",
                "DB_NAME": "NEETASTUDIO",
                "DB_USER": "neetastudio",
                "DB_PASSWORD": "paSSW0rd",
                "DB_PASSWORD_FILE_PATH": "/run/secrets/mysql-root-password",
            },
            "envFile": "${workspaceFolder}/envvars"
        },
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9000,
            "pathMappings": {
                "/var/www/html": "${workspaceFolder}",
            },
            "runtimeArgs": [
                "-dxdebug.mode=debug,develop",
            ],
            "envFile": "${workspaceFolder}/envvars"
        }
    ]
}
